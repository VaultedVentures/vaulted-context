{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/VaultedVentures/vaulted-context/main/schemas/vois-blueprint.json",
  "title": "VOIS Blueprint",
  "description": "Native canonical format for Vaulted Objects Infrastructure Simulator blueprints. This is the lossless source of truth — all external formats (BPMN, Mermaid, JSON-LD, etc.) are projections from this model.",
  "type": "object",
  "required": ["format", "version", "name"],
  "properties": {
    "format": {
      "const": "vois-blueprint",
      "description": "Format identifier — must be 'vois-blueprint' for all native blueprints."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version (semver). Current: 0.1.0."
    },
    "name": {
      "type": "string",
      "description": "Human-readable blueprint name."
    },
    "industry": {
      "type": "string",
      "description": "Target industry sector (e.g. 'insurance', 'legal', 'government', 'defence', 'healthcare', 'finance', 'ai-governance')."
    },
    "scenario": {
      "type": "string",
      "description": "Specific scenario or workflow being modelled (e.g. 'Claim evidence workflow')."
    },
    "description": {
      "type": "string",
      "description": "Extended description of the blueprint purpose and scope."
    },

    "actors": {
      "type": "array",
      "description": "Humans, organisations, or systems that participate in the workflow.",
      "items": {
        "$ref": "#/definitions/Actor"
      }
    },
    "agents": {
      "type": "array",
      "description": "Autonomous AI or software actors with delegated authority to act.",
      "items": {
        "$ref": "#/definitions/Agent"
      }
    },
    "objects": {
      "type": "array",
      "description": "Digital objects — data items, documents, records, credentials, or vaulted objects.",
      "items": {
        "$ref": "#/definitions/DigitalObject"
      }
    },
    "authorities": {
      "type": "array",
      "description": "Entities empowered to issue seals, verify possession, or attest attributes.",
      "items": {
        "$ref": "#/definitions/Authority"
      }
    },
    "events": {
      "type": "array",
      "description": "Provenance and lifecycle events: creation, modification, transfer, verification, sealing.",
      "items": {
        "$ref": "#/definitions/Event"
      }
    },
    "controls": {
      "type": "array",
      "description": "Policy, governance, or approval control points in the workflow.",
      "items": {
        "$ref": "#/definitions/Control"
      }
    },
    "proofs": {
      "type": "array",
      "description": "Types of evidence or proofs generated by the workflow (seals, signatures, audit records).",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "digital_seal",
              "its_signature",
              "possession_proof",
              "verification_record",
              "audit_log",
              "attestation",
              "certificate"
            ]
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "produced_by": {
            "$ref": "#/definitions/EntityRef",
            "description": "The event or control that produces this proof."
          },
          "consumed_by": {
            "$ref": "#/definitions/EntityRef",
            "description": "The verification event that checks this proof."
          }
        },
        "required": ["id", "type"]
      }
    },
    "nodes": {
      "type": "array",
      "description": "Simulator nodes for the blueprint board visualisation.",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "edges": {
      "type": "array",
      "description": "Connections between simulator nodes (workflow flow, data flow, control flow).",
      "items": {
        "$ref": "#/definitions/Edge"
      }
    },
    "risks": {
      "type": "array",
      "description": "Identified risks, failure modes, and mitigations.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "affected_entities": {
            "type": "array",
            "items": { "$ref": "#/definitions/EntityRef" }
          },
          "mitigation": { "type": "string" }
        },
        "required": ["id", "name"]
      }
    },
    "exports": {
      "type": "array",
      "description": "External format projections available or planned for this blueprint.",
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "bpmn-2.0", "json-ld", "mermaid", "oscal",
              "w3c-prov", "c4", "structurizr", "dmn",
              "openapi", "asyncapi", "graphviz", "yaml"
            ]
          },
          "description": { "type": "string" },
          "mapping_status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "complete", "deprecated"]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Link to generated export or mapping reference."
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "description": "Integration decisions, design questions, or unknowns surfaced during blueprint creation.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "context": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "resolved", "deferred"]
          },
          "resolution": { "type": "string" }
        },
        "required": ["id", "question"]
      }
    }
  },

  "definitions": {
    "EntityRef": {
      "type": "object",
      "description": "A reference to another entity in the blueprint by its ID.",
      "properties": {
        "ref": { "type": "string" },
        "entity_type": {
          "type": "string",
          "enum": [
            "actor", "agent", "object", "authority", "event",
            "control", "proof", "node", "risk"
          ]
        }
      },
      "required": ["ref"]
    },
    "Actor": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["human", "organisation", "system", "role"]
        },
        "description": { "type": "string" },
        "trust_boundary": {
          "type": "string",
          "description": "Which trust boundary this actor belongs to."
        }
      },
      "required": ["id", "name"]
    },
    "Agent": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["ai_agent", "software_bot", "autonomous_system"]
        },
        "description": { "type": "string" },
        "delegated_by": {
          "$ref": "#/definitions/EntityRef",
          "description": "The authority or actor that delegated power to this agent."
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Boundaries on the agent's authority or action."
        }
      },
      "required": ["id", "name"]
    },
    "DigitalObject": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "document", "record", "credential", "vaulted_object",
            "claim", "evidence", "message", "token"
          ]
        },
        "description": { "type": "string" },
        "is_vaulted": {
          "type": "boolean",
          "description": "Whether this object is bound to ITS proofs."
        },
        "possessed_by": {
          "type": "array",
          "items": { "$ref": "#/definitions/EntityRef" },
          "description": "Current possessor(s) of this object."
        },
        "lifecycle_state": {
          "type": "string",
          "description": "Current state in the object lifecycle."
        },
        "lifecycle_transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_state": { "type": "string" },
              "to_state": { "type": "string" },
              "trigger_event": { "$ref": "#/definitions/EntityRef" }
            }
          }
        }
      },
      "required": ["id", "name"]
    },
    "Authority": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "certifying_authority", "regulatory_body",
            "trusted_third_party", "internal_authority",
            "self_sovereign", "hierarchical"
          ]
        },
        "description": { "type": "string" },
        "seal_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "origin_seal", "authority_seal", "attestation",
              "integrity_seal", "possession_seal"
            ]
          },
          "description": "Types of seals this authority can issue."
        },
        "verification_method": {
          "type": "string",
          "description": "How this authority verifies claims."
        },
        "trust_anchor": {
          "type": "string",
          "description": "The root of trust for this authority."
        }
      },
      "required": ["id", "name"]
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "creation", "modification", "transfer", "verification",
            "sealing", "attestation", "possession_change",
            "authority_delegation", "audit", "destruction"
          ]
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the event occurred or is expected to occur."
        },
        "actor": { "$ref": "#/definitions/EntityRef" },
        "object": { "$ref": "#/definitions/EntityRef" },
        "authority": { "$ref": "#/definitions/EntityRef" },
        "result": {
          "type": "string",
          "description": "Outcome of the event."
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/EntityRef" },
          "description": "Proofs or evidence produced by this event."
        }
      },
      "required": ["id", "type", "name"]
    },
    "Control": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "approval_gate", "verification_check", "policy_enforcement",
            "audit_trigger", "escalation", "human_review",
            "seal_requirement", "possession_check"
          ]
        },
        "description": { "type": "string" },
        "governance_rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The policies or rules that govern this control."
        },
        "controlled_by": {
          "$ref": "#/definitions/EntityRef",
          "description": "The authority that enforces this control."
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entity_type": {
                "type": "string",
                "enum": ["object", "actor", "agent", "event"]
              },
              "entity_ref": { "$ref": "#/definitions/EntityRef" }
            }
          },
          "description": "Which entities this control applies to."
        }
      },
      "required": ["id", "name"]
    },
    "Node": {
      "type": "object",
      "description": "A visual node on the simulator blueprint board. Maps to one or more blueprint entities.",
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "actor", "agent", "object", "authority", "event",
            "control", "proof", "gateway", "pool", "lane"
          ],
          "description": "Visual type — determines appearance on the board."
        },
        "label": { "type": "string" },
        "entity_ref": { "$ref": "#/definitions/EntityRef" },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "metadata": {
          "type": "object",
          "description": "Arbitrary key-value metadata for the node."
        }
      },
      "required": ["id", "type"]
    },
    "Edge": {
      "type": "object",
      "description": "A directional connection between two simulator nodes.",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "flow", "data_flow", "control_flow",
            "possession", "authority", "verification",
            "message", "delegation"
          ],
          "description": "Semantic type of the connection."
        },
        "label": { "type": "string" },
        "metadata": {
          "type": "object",
          "description": "Arbitrary key-value metadata for the edge."
        }
      },
      "required": ["id", "source", "target"]
    }
  }
}
